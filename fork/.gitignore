/.venv-experimental/
/.venv-tlc/
/outputs/
/build/
# Installing or building fork/tlc writes its metadata, and for a non-editable install or a wheel build/ and dist/,
# into the package directory.
/tlc/src/*.egg-info/
/tlc/build/
/tlc/dist/
# fork/bilingual: its GPU-host environment, and what installing or building the package writes into it. No trailing
# slash on the environment, so that `git check-ignore fork/.venv-bilingual` holds before the directory exists.
/.venv-bilingual
/bilingual/src/*.egg-info/
/bilingual/build/
/bilingual/dist/
# fork/corpora and fork/tokstudy: their environments (no trailing slash, as above) and build outputs.
/.venv-corpora
/corpora/src/*.egg-info/
/corpora/build/
/corpora/dist/
/.venv-tokstudy
/tokstudy/src/*.egg-info/
/tokstudy/build/
/tokstudy/dist/
